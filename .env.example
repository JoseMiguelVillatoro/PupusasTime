# Solo para `npx vercel dev` en local. En producción se configura en Vercel.
GOOGLE_PLACES_API_KEY=<tu-api-key-de-google-places>
# Opcional: orígenes permitidos, separados por comas.
# ALLOWED_ORIGINS=https://pupusas-time.vercel.app,http://localhost:3000

# Opcional: cambiar el proyecto de Supabase (por defecto usa el de Pupusas Time).
# VITE_SUPABASE_URL=https://<proyecto>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Desarrollo: VITE_SHARED_BACKEND=memory para simular varios teléfonos sin Supabase.
